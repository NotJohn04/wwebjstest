# Every WhatsApp event gets POSTed here
WEBHOOK_URL=https://webhook.site/your-unique-id

# What to do with images / videos / voice notes / documents:
#   full    = put the whole base64 file in the webhook (can be big)
#   preview = only the first 300 chars of base64
#   none    = no base64, just metadata
MEDIA_BASE64=full

# Also save every downloaded media file into ./media
SAVE_MEDIA=true
